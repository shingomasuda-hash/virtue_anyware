# PostgreSQL (Neon 互換)。本番の値は絶対にコミットしないこと。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/virtue_dev?schema=public"

# 32 バイト以上のランダム文字列。`openssl rand -base64 32` で生成する。
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret-value!!"
BETTER_AUTH_URL="http://localhost:3000"

# テスト専用 DB。開発 DB を破壊しないよう分離する。
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/virtue_test?schema=public"
